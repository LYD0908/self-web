---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TOC from '../components/TOC.astro';
import Comments from '../components/Comments.astro';
import { CATEGORIES, SPONSOR } from '../consts';
import { formatDate } from '../utils/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  readingTime: number;
  headings: { depth: number; slug: string; text: string }[];
  cover?: string;
  coverColor?: string;
  prev?: { title: string; url: string } | null;
  next?: { title: string; url: string } | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  readingTime,
  headings,
  coverColor = 'purple',
  prev = null,
  next = null,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = CATEGORIES.find((c) => c.id === category);
const colorVar = `var(--macaron-${coverColor})`;
---

<BaseLayout
  title={title}
  description={description}
  progress={true}
  showNav={true}
>
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid gap-10 xl:grid-cols-[minmax(0,1fr)_220px]">
      <article class="min-w-0">
        <!-- 返回 -->
        <a
          href={`${base}/blog/`}
          class="mb-6 inline-flex items-center gap-1 text-sm text-ink-muted hover:text-ink-strong"
        >
          <Icon name="arrowLeft" class="h-4 w-4" />
          返回博客
        </a>

        <!-- 头部 -->
        <header class="mb-10">
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <a
              href={`${base}/categories/${category}/`}
              class={`chip chip-${cat?.color || 'purple'}`}
            >
              <Icon name={cat?.icon || 'pen'} class="h-3 w-3" />
              {cat?.label || category}
            </a>
          </div>

          <h1
            class="text-3xl font-black leading-tight text-ink-strong sm:text-[2.5rem]"
          >
            {title}
          </h1>

          {
            description && (
              <p class="mt-3 text-base text-ink-muted">{description}</p>
            )
          }

          <div
            class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-line py-3 text-xs text-ink-muted"
          >
            <span class="inline-flex items-center gap-1.5">
              <Icon name="calendar" class="h-3.5 w-3.5" />
              {formatDate(pubDate)}
            </span>
            {
              updatedDate && (
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="pen" class="h-3.5 w-3.5" />
                  更新于 {formatDate(updatedDate)}
                </span>
              )
            }
            <span class="inline-flex items-center gap-1.5">
              <Icon name="clock" class="h-3.5 w-3.5" />
              约 {readingTime} 分钟
            </span>
          </div>
        </header>

        <!-- 移动端目录 -->
        <TOC headings={headings} />

        <!-- 正文（data-pagefind-body：只让文章正文进入搜索索引） -->
        <div class="prose" data-pagefind-body>
          <slot />
        </div>

        <!-- 标签 -->
        {
          tags.length > 0 && (
            <div class="mt-12 flex flex-wrap items-center gap-2">
              <Icon name="tag" class="h-4 w-4 text-ink-muted" />
              {tags.map((t) => (
                <a
                  href={`${base}/tags/${encodeURIComponent(t)}/`}
                  class="chip hover:!text-ink-strong"
                >
                  {t}
                </a>
              ))}
            </div>
          )
        }

        <!-- 打赏 -->
        {
          SPONSOR.enabled && (
            <div class="card mt-10 p-6 text-center">
              <Icon name="coffee" class="mx-auto mb-2 h-6 w-6 text-ink-muted" />
              <p class="mb-4 text-sm text-ink-muted">{SPONSOR.tip}</p>
              <div class="flex items-center justify-center gap-6">
                <img
                  src={SPONSOR.wechat}
                  alt="微信打赏"
                  class="h-40 w-40 rounded-xl border border-line object-cover"
                />
                <img
                  src={SPONSOR.alipay}
                  alt="支付宝打赏"
                  class="h-40 w-40 rounded-xl border border-line object-cover"
                />
              </div>
            </div>
          )
        }

        <!-- 上下篇 -->
        {
          (prev || next) && (
            <nav class="mt-10 grid gap-3 sm:grid-cols-2">
              {prev ? (
                <a href={prev.url} class="card card-hover flex flex-col gap-1 p-4">
                  <span class="flex items-center gap-1 text-xs text-ink-muted">
                    <Icon name="arrowLeft" class="h-3.5 w-3.5" />
                    上一篇
                  </span>
                  <span class="text-sm font-semibold text-ink-strong">
                    {prev.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a
                  href={next.url}
                  class="card card-hover flex flex-col items-end gap-1 p-4 text-right"
                >
                  <span class="flex items-center gap-1 text-xs text-ink-muted">
                    下一篇
                    <Icon name="arrowRight" class="h-3.5 w-3.5" />
                  </span>
                  <span class="text-sm font-semibold text-ink-strong">
                    {next.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }

        <Comments />
      </article>

      <!-- 侧栏目录 -->
      <div class="hidden xl:block">
        <TOC headings={headings} />
      </div>
    </div>
  </div>
</BaseLayout>
