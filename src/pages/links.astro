---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { FRIEND_LINKS, SPONSOR } from '../consts';
---

<BaseLayout title="友链" description="朋友们的站点，以及常逛的地方。">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <h1 class="mb-2 text-3xl font-black text-ink-strong sm:text-4xl">
      <span class="text-gradient">友链</span>
    </h1>
    <p class="mb-10 text-sm text-ink-muted">
      在 <code class="rounded bg-surface-2 px-1.5 py-0.5 text-[13px]"
        >src/consts.ts</code
      > 的 FRIEND_LINKS 里增删。
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        FRIEND_LINKS.map((f) => (
          <a
            href={f.url}
            target="_blank"
            rel="noopener"
            class="card card-hover group flex items-center gap-4 p-5"
          >
            <span
              class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-full text-base font-bold text-white"
              style="background: var(--grad-2)"
            >
              {f.avatar ? (
                <img src={f.avatar} alt={f.name} class="h-full w-full object-cover" />
              ) : (
                f.name.slice(0, 1)
              )}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-bold text-ink-strong">
                {f.name}
              </span>
              <span class="block truncate text-xs text-ink-muted">{f.desc}</span>
            </span>
            <Icon
              name="external"
              class="h-4 w-4 shrink-0 text-ink-muted opacity-0 transition-opacity group-hover:opacity-100"
            />
          </a>
        ))
      }
    </div>

    <!-- 打赏 -->
    <section class="mt-12">
      <h2
        class="mb-5 flex items-center gap-2 text-xl font-bold text-ink-strong"
      >
        <Icon name="coffee" class="h-5 w-5" />
        请我喝杯咖啡
      </h2>
      {
        SPONSOR.enabled ? (
          <div class="card p-8 text-center">
            <p class="mb-5 text-sm text-ink-muted">{SPONSOR.tip}</p>
            <div class="flex flex-wrap items-center justify-center gap-6">
              <img
                src={SPONSOR.wechat}
                alt="微信收款码"
                class="h-44 w-44 rounded-xl border border-line object-cover"
              />
              <img
                src={SPONSOR.alipay}
                alt="支付宝收款码"
                class="h-44 w-44 rounded-xl border border-line object-cover"
              />
            </div>
          </div>
        ) : (
          <div class="card border-dashed bg-transparent p-10 text-center shadow-none">
            <Icon name="coffee" class="mx-auto mb-3 h-7 w-7 text-ink-muted" />
            <p class="text-sm text-ink-muted">
              把收款码图片放到{' '}
              <code class="rounded bg-surface-2 px-1.5 py-0.5 text-[13px]">
                public/
              </code>{' '}
              下，然后在{' '}
              <code class="rounded bg-surface-2 px-1.5 py-0.5 text-[13px]">
                src/consts.ts
              </code>{' '}
              里把 SPONSOR.enabled 改成 true 即可启用。
            </p>
          </div>
        )
      }
    </section>

    <!-- 申请交换友链 -->
    <section class="mt-10">
      <div class="card p-6">
        <h3 class="mb-2 font-bold text-ink-strong">想交换友链？</h3>
        <p class="text-sm text-ink-muted">
          欢迎通过页面底部或「关于我」里的任一联系方式找我，附上你的站点名、链接和一句话简介就好。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
