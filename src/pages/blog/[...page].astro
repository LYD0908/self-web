---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../consts';
import { getPosts, readingTime, collectTags } from '../../utils/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  // 只传列表需要的字段，避免把 render() / body 一起塞进 props
  return paginate(
    posts.map((p) => ({
      slug: p.slug,
      data: p.data,
      readingTime: readingTime(p.body || ''),
    })),
    { pageSize: 9 }
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tags = collectTags(
  await getPosts()
).slice(0, 18);
---

<BaseLayout title="博客" description="全部文章归档，按板块与标签浏览。">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <!-- 标题 -->
    <div class="mb-10 flex flex-col gap-3">
      <h1 class="text-3xl font-black text-ink-strong sm:text-4xl">
        <span class="text-gradient">博客</span>
      </h1>
      <p class="text-sm text-ink-muted">
        共 {page.total} 篇文章 · 第 {page.currentPage} / {page.lastPage} 页
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1fr_260px]">
      <!-- 文章列表 -->
      <div>
        {
          page.data.length > 0 ? (
            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
              {page.data.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          ) : (
            <div class="card border-dashed bg-transparent p-12 text-center shadow-none">
              <Icon name="pen" class="mx-auto mb-3 h-8 w-8 text-ink-muted" />
              <p class="text-sm text-ink-muted">这里还没有文章。</p>
            </div>
          )
        }

        <!-- 分页 -->
        {
          page.lastPage > 1 && (
            <nav class="mt-12 flex items-center justify-center gap-2">
              <a
                href={page.url.prev ? `${base}${page.url.prev}` : '#'}
                class:list={[
                  'btn',
                  !page.url.prev && 'pointer-events-none opacity-40',
                ]}
                aria-label="上一页"
              >
                <Icon name="arrowLeft" class="h-4 w-4" />
                上一页
              </a>
              <span class="px-3 text-sm text-ink-muted">
                {page.currentPage} / {page.lastPage}
              </span>
              <a
                href={page.url.next ? `${base}${page.url.next}` : '#'}
                class:list={[
                  'btn',
                  !page.url.next && 'pointer-events-none opacity-40',
                ]}
                aria-label="下一页"
              >
                下一页
                <Icon name="chevronRight" class="h-4 w-4" />
              </a>
            </nav>
          )
        }
      </div>

      <!-- 侧栏 -->
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="card p-5">
          <h2 class="mb-3 flex items-center gap-1.5 text-sm font-bold text-ink-strong">
            <Icon name="book" class="h-4 w-4" />
            板块
          </h2>
          <div class="flex flex-col gap-1">
            {
              CATEGORIES.map((c) => (
                <a
                  href={`${base}/categories/${c.id}/`}
                  class="flex items-center justify-between rounded-lg px-2.5 py-2 text-sm text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink-strong"
                >
                  <span class="inline-flex items-center gap-2">
                    <Icon name={c.icon} class="h-4 w-4" />
                    {c.label}
                  </span>
                  <Icon name="chevronRight" class="h-3.5 w-3.5" />
                </a>
              ))
            }
          </div>
        </div>

        {
          tags.length > 0 && (
            <div class="card p-5">
              <h2 class="mb-3 flex items-center gap-1.5 text-sm font-bold text-ink-strong">
                <Icon name="tag" class="h-4 w-4" />
                标签
              </h2>
              <div class="flex flex-wrap gap-1.5">
                {tags.map(({ tag, count }) => (
                  <a href={`${base}/tags/${encodeURIComponent(tag)}/`} class="chip">
                    {tag}
                    <span class="text-[10px] opacity-60">{count}</span>
                  </a>
                ))}
              </div>
              <a
                href={`${base}/tags/`}
                class="mt-3 inline-flex items-center gap-1 text-xs text-ink-muted hover:text-ink-strong"
              >
                全部标签
                <Icon name="arrowRight" class="h-3 w-3" />
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
