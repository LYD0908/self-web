---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIALS, TIMELINE, SKILLS } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="关于我" description={`关于 ${SITE.name} —— 经历、技能与联系方式。`}>
  <div class="mx-auto max-w-4xl px-5 py-12">
    <!-- 名片 -->
    <section class="card overflow-hidden">
      <div
        class="h-28 w-full"
        style="background: var(--grad-1); opacity:.9"
      ></div>
      <div class="-mt-14 px-6 pb-8 sm:px-10">
        <div
          class="grid h-24 w-24 place-items-center rounded-3xl border-4 text-3xl font-black text-white shadow-xl"
          style="background: var(--grad-2); border-color: var(--surface)"
        >
          {SITE.name.slice(0, 1)}
        </div>

        <h1 class="mt-4 text-2xl font-black text-ink-strong sm:text-3xl">
          {SITE.realName}
          <span class="ml-2 text-base font-normal text-ink-muted"
            >@{SITE.handle}</span
          >
        </h1>
        <p class="mt-1 text-sm text-ink-muted">{SITE.slogan}</p>

        <div
          class="mt-5 max-w-2xl space-y-4 text-[15px] leading-relaxed text-ink"
        >
          <p>
            南昌航空大学科技学院计算机科学与技术专业 2027 届本科生。做校园业务三年，
            把中国电信天翼创业社从 5 个人带到 120 多人，覆盖共青城 6 所高校，累计服务新生 3000+；
            同时自己写代码，把一线踩到的坑做成 AI 应用。
            「既懂客户又懂技术」是我最想守住的差异化。
          </p>
          <p>
            我做 AI 的方式有点「土」——不追概念，先问真正的痛点在哪，再判断 AI 能不能解决、值不值得做。
            校园电话卡 AI 提效系统就是这么来的：访谈一圈一线销售和新人，卡点落在「内容产能不足」和
            「话术不统一」，于是用 LangGraph 编排内容生成、话术推荐、知识问答三类 Agent，
            FastAPI 封装出去，120 多号人全员试用。
            验收标准只有一个 —— <strong class="text-ink-strong">团队真的在用</strong>。
          </p>
          <p>
            另外一件正在做的事：把三年攒下的 194 份资料交给大模型增量编译成一套互链的 wiki，
            自己只负责提问和拍板。人工维护知识库会崩，是因为「记账」的负担增长快过价值；
            大模型不会腻、不会漏改 —— 这套 「LLM 维基模式」我写成了文章，在博客里。
          </p>
          <p>
            在这之前，我卖过水、送过外卖、做过全校最大的宿舍打印，也复读过一年（408 → 469）。
            这些事有个共同点：都得先自己把流程跑通，再让别人也能照着做。
            所以我习惯把经验沉淀成 SOP、话术库和培训流程，而不是只留在自己脑子里。
          </p>
          <p>
            这个网站放的是我做过什么、想过什么、以及踩过的坑 —— 包括那些没做完的部分。
            如果你也在做 AI 落地、校园市场，或者只是想聊聊，都欢迎找我。
          </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                class="btn !px-3.5 !py-2 !text-[13px]"
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
              >
                <Icon name={s.icon} class="h-4 w-4" />
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 技能 -->
    <section class="mt-10">
      <h2
        class="mb-5 flex items-center gap-2 text-xl font-bold text-ink-strong"
      >
        <Icon name="sparkles" class="h-5 w-5" />
        技能栈
      </h2>
      <div class="card space-y-4 p-6">
        {
          SKILLS.map((s) => (
            <div>
              <div class="mb-1.5 flex items-center justify-between text-sm">
                <span class="text-ink-strong">{s.name}</span>
                <span class="text-xs text-ink-muted">{s.level}%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-surface-2">
                <div
                  class="h-full rounded-full transition-all duration-700"
                  style={`width:${s.level}%; background: var(--macaron-${s.color})`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 经历 -->
    <section class="mt-10">
      <h2
        class="mb-5 flex items-center gap-2 text-xl font-bold text-ink-strong"
      >
        <Icon name="clock" class="h-5 w-5" />
        经历
      </h2>
      <ol class="relative space-y-6 border-l-2 border-line pl-6">
        {
          TIMELINE.map((t) => (
            <li class="relative">
              <span
                class="absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full border-2"
                style="background: var(--macaron-purple); border-color: var(--surface)"
              />
              <div class="text-xs font-semibold text-ink-muted">{t.year}</div>
              <div class="mt-0.5 text-[15px] font-bold text-ink-strong">
                {t.title}
              </div>
              <p class="mt-1 text-sm text-ink-muted">{t.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 联系 -->
    <section class="mt-10">
      <div class="card p-8 text-center">
        <Icon name="heart" class="mx-auto mb-3 h-7 w-7 text-ink-muted" />
        <h2 class="text-lg font-bold text-ink-strong">聊聊？</h2>
        <p class="mt-2 text-sm text-ink-muted">
          有想法、有合作、或者只是想打个招呼，都欢迎联系我。
        </p>
        <a href={`${base}/links`} class="btn btn-primary mt-5">
          <Icon name="link" class="h-4 w-4" />
          去友链页看看
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
