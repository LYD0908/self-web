---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="页面不存在" description="404">
  <div
    class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center gap-6 px-5 text-center"
  >
    <div
      class="text-7xl font-black text-gradient sm:text-8xl"
      style="letter-spacing:-0.04em"
    >
      404
    </div>
    <p class="text-ink-muted">这个页面走丢了，或者从来没存在过。</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={`${base}/`} class="btn btn-primary">
        <Icon name="home" class="h-4 w-4" />
        回首页
      </a>
      <a href={`${base}/blog/`} class="btn">
        <Icon name="book" class="h-4 w-4" />
        去博客
      </a>
      <a href={`${base}/search`} class="btn">
        <Icon name="search" class="h-4 w-4" />
        搜一搜
      </a>
    </div>
  </div>
</BaseLayout>
