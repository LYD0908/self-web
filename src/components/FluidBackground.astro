---
/**
 * 马卡龙渐变流体背景
 * Canvas 2D 实现：多层马卡龙色 blob 缓慢漂移 + 鼠标轨迹注入彩色粒子
 * 尊重 prefers-reduced-motion，且页面不可见时自动暂停
 */
---

<canvas id="fluid-bg" class="fixed inset-0 -z-10 h-full w-full"></canvas>

<script>
  (function () {
    const canvas = document.getElementById('fluid-bg');
    if (!canvas) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const COLORS = ['#ffb3c6', '#c4a7f7', '#9fe6cf', '#a8d5ff', '#ffe1a8'];

    let w = 0;
    let h = 0;
    let dpr = 1;
    const blobs = [];
    const trails = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function initBlobs() {
      blobs.length = 0;
      const count = Math.min(7, Math.max(4, Math.floor(w / 260)));
      for (let i = 0; i < count; i++) {
        blobs.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: (0.28 + Math.random() * 0.3) * Math.min(w, h),
          vx: (Math.random() - 0.5) * 0.16,
          vy: (Math.random() - 0.5) * 0.16,
          color: COLORS[i % COLORS.length],
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function drawBlobs(t) {
      ctx.globalCompositeOperation = 'lighter';
      for (const b of blobs) {
        b.x += b.vx;
        b.y += b.vy;
        if (b.x < -b.r) b.x = w + b.r;
        if (b.x > w + b.r) b.x = -b.r;
        if (b.y < -b.r) b.y = h + b.r;
        if (b.y > h + b.r) b.y = -b.r;

        const pulse = 1 + Math.sin(t * 0.0004 + b.phase) * 0.12;
        const r = b.r * pulse;
        const g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, r);
        g.addColorStop(0, hexToRgba(b.color, 0.5));
        g.addColorStop(0.45, hexToRgba(b.color, 0.16));
        g.addColorStop(1, hexToRgba(b.color, 0));
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(b.x, b.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
    }

    function drawTrails() {
      ctx.globalCompositeOperation = 'lighter';
      for (let i = trails.length - 1; i >= 0; i--) {
        const p = trails[i];
        p.life -= 0.014;
        if (p.life <= 0) {
          trails.splice(i, 1);
          continue;
        }
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.97;
        p.vy *= 0.97;
        p.r += 0.9;
        const alpha = p.life * 0.34;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
        g.addColorStop(0, hexToRgba(p.color, alpha));
        g.addColorStop(1, hexToRgba(p.color, 0));
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
    }

    function spawn(x, y) {
      if (trails.length > 90) return;
      const color = COLORS[Math.floor(Math.random() * COLORS.length)];
      trails.push({
        x,
        y,
        vx: (Math.random() - 0.5) * 1.6,
        vy: (Math.random() - 0.5) * 1.6,
        r: 12 + Math.random() * 22,
        life: 1,
        color,
      });
    }

    function hexToRgba(hex, a) {
      const n = parseInt(hex.slice(1), 16);
      return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
    }

    let frame = 0;
    let running = true;

    function loop(t) {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);
      drawBlobs(t);
      drawTrails();
      frame = requestAnimationFrame(loop);
    }

    function start() {
      if (running && !frame) frame = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    }

    resize();
    initBlobs();

    window.addEventListener('resize', () => {
      resize();
      initBlobs();
    });

    if (!reduce) {
      start();
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
        } else if (!frame) {
          frame = requestAnimationFrame(loop);
        }
      });
    } else {
      // 静态渲染一帧
      drawBlobs(0);
    }

    let last = 0;
    window.addEventListener(
      'pointermove',
      (e) => {
        if (reduce) return;
        const now = Date.now();
        if (now - last < 34) return;
        last = now;
        spawn(e.clientX, e.clientY);
      },
      { passive: true }
    );

    window.addEventListener(
      'pointerdown',
      (e) => {
        if (reduce) return;
        for (let i = 0; i < 5; i++) spawn(e.clientX, e.clientY);
      },
      { passive: true }
    );
  })();
</script>
