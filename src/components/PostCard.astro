---
import Icon from './Icon.astro';
import { CATEGORIES } from '../consts';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      category: string;
      tags: string[];
      pinned?: boolean;
      cover?: string;
      coverColor?: string;
    };
    /** 阅读时间（分钟），由调用方计算后传入 */
    readingTime?: number;
  };
  /** featured：首页大卡片 */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = CATEGORIES.find((c) => c.id === post.data.category);
const href = `${base}/blog/${post.slug}/`;
const dateStr = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const colorVar = `var(--macaron-${post.data.coverColor || 'purple'})`;
---

<article class:list={['card card-hover overflow-hidden group', featured && 'sm:col-span-2']}>
  <a href={href} class="flex h-full flex-col">
    <!-- 封面区 -->
    <div
      class="relative flex h-32 items-end overflow-hidden sm:h-36"
      style={`background: linear-gradient(135deg, ${colorVar}33, ${colorVar}0d)`}
    >
      {
        post.data.cover && (
          <img
            src={post.data.cover}
            alt={post.data.title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
        )
      }
      <div
        class="absolute -right-6 -top-8 h-24 w-24 rounded-full opacity-40 blur-xl transition-transform duration-500 group-hover:scale-125"
        style={`background: ${colorVar}`}
      >
      </div>
      <div class="relative z-10 flex w-full items-center gap-2 px-5 pb-3">
        <span class={`chip chip-${cat?.color || 'purple'}`}>
          <Icon name={cat?.icon || 'pen'} class="h-3 w-3" />
          {cat?.label || post.data.category}
        </span>
        {
          post.data.pinned && (
            <span class="chip chip-yellow">
              <Icon name="sparkles" class="h-3 w-3" />
              置顶
            </span>
          )
        }
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-2.5 p-5">
      <h3
        class:list={[
          'font-bold text-ink-strong leading-snug transition-colors group-hover:text-gradient',
          featured ? 'text-xl sm:text-2xl' : 'text-base',
        ]}
      >
        {post.data.title}
      </h3>

      {
        post.data.description && (
          <p class="line-clamp-2 text-sm text-ink-muted">
            {post.data.description}
          </p>
        )
      }

      <div
        class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 text-xs text-ink-muted"
      >
        <span class="inline-flex items-center gap-1">
          <Icon name="calendar" class="h-3.5 w-3.5" />
          {dateStr}
        </span>
        {
          post.readingTime ? (
            <span class="inline-flex items-center gap-1">
              <Icon name="clock" class="h-3.5 w-3.5" />
              {post.readingTime} min
            </span>
          ) : null
        }
        {
          post.data.tags.slice(0, 3).map((t) => (
            <span class="inline-flex items-center gap-0.5">
              <span class="text-ink-muted/70">#</span>
              {t}
            </span>
          ))
        }
      </div>
    </div>
  </a>
</article>
