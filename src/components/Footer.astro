---
import Icon from './Icon.astro';
import { SITE, SOCIALS } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const yearText =
  year === SITE.sinceYear ? `${year}` : `${SITE.sinceYear} – ${year}`;
---

<footer class="mt-24 border-t border-line bg-bg-soft/60">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-12 text-center"
  >
    <div class="flex flex-wrap items-center justify-center gap-2">
      {
        SOCIALS.filter((s) => s.href).map((s) => (
          <a
            href={s.href}
            class="btn !px-3 !py-2"
            aria-label={s.label}
            title={s.label}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
          >
            <Icon name={s.icon} class="h-4 w-4" />
          </a>
        ))
      }
    </div>

    <p class="max-w-md text-sm text-ink-muted">
      {SITE.description}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-ink-muted">
      <span>© {yearText} {SITE.name}</span>
      <a href={`${base}/rss.xml`} class="hover:text-ink-strong">RSS</a>
      <a href={`${base}/links`} class="hover:text-ink-strong">友链</a>
      <a href={`${base}/about`} class="hover:text-ink-strong">关于</a>
      {SITE.icp && <span>{SITE.icp}</span>}
    </div>
  </div>
</footer>
