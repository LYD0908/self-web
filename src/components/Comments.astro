---
import Icon from './Icon.astro';
import { COMMENT } from '../consts';
---

<section class="mt-16" id="comments">
  <div class="mb-4 flex items-center gap-2 text-lg font-bold text-ink-strong">
    <Icon name="quote" class="h-5 w-5" />
    评论
  </div>

  {
    COMMENT.enabled ? (
      <div class="card p-2 sm:p-4">
        <script
          src="https://giscus.app/client.js"
          data-repo={COMMENT.repo}
          data-repo-id={COMMENT.repoId}
          data-category={COMMENT.category}
          data-category-id={COMMENT.categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang={COMMENT.lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    ) : (
      <div class="card border-dashed bg-transparent p-8 text-center shadow-none">
        <Icon name="quote" class="mx-auto mb-3 h-7 w-7 text-ink-muted" />
        <p class="text-sm text-ink-muted">
          评论区还没启用。在
          <code class="mx-1 rounded bg-surface-2 px-1.5 py-0.5 text-[13px]">
            src/consts.ts
          </code>
          里填好 Giscus 配置并把
          <code class="mx-1 rounded bg-surface-2 px-1.5 py-0.5 text-[13px]">
            enabled
          </code>
          改成 <code class="rounded bg-surface-2 px-1.5 py-0.5 text-[13px]">true</code>
          就能开启。
        </p>
      </div>
    )
  }
</section>
