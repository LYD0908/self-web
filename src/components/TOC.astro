---
import Icon from './Icon.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const list = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  list.length > 1 && (
    <>
      <!-- 桌面端侧栏目录 -->
      <aside class="toc-side hidden xl:block">
        <div class="sticky top-24">
          <div class="mb-3 flex items-center gap-1.5 text-xs font-semibold tracking-wider text-ink-muted uppercase">
            <Icon name="list" class="h-3.5 w-3.5" />
            目录
          </div>
          <nav class="max-h-[70vh] overflow-y-auto border-l border-line pl-3 text-sm">
            {list.map((h) => (
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  'block py-1.5 leading-snug text-ink-muted transition-all hover:text-ink-strong',
                  h.depth === 2 ? 'pl-0' : 'pl-3 text-[13px]',
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- 移动端折叠目录 -->
      <details class="card mb-8 xl:hidden">
        <summary class="flex cursor-pointer items-center gap-2 px-5 py-3 text-sm font-semibold text-ink-strong">
          <Icon name="list" class="h-4 w-4" />
          目录
        </summary>
        <nav class="border-t border-line px-5 py-3 text-sm">
          {list.map((h) => (
            <a
              href={`#${h.slug}`}
              class:list={[
                'block py-1.5 text-ink-muted hover:text-ink-strong',
                h.depth === 2 ? 'pl-0' : 'pl-4 text-[13px]',
              ]}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </details>
    </>
  )
}

<script>
  (function () {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
    );
    if (!links.length) return;

    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.tocLink || '', l));

    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink || ''))
      .filter((el): el is HTMLElement => !!el);

    if (!targets.length) return;

    function setActive(id: string) {
      links.forEach((l) => {
        const on = l.dataset.tocLink === id;
        l.style.color = on ? 'var(--text-strong)' : '';
        l.style.fontWeight = on ? '600' : '';
        l.style.borderLeft = on ? '2px solid var(--macaron-purple)' : '';
        l.style.paddingLeft = on ? '10px' : '';
        l.style.marginLeft = on ? '-11px' : '';
      });
    }

    let ticking = false;
    function update() {
      const top = window.scrollY + 140;
      let current = targets[0].id;
      for (const t of targets) {
        if (t.offsetTop <= top) current = t.id;
      }
      setActive(current);
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  })();
</script>
